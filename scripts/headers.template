# Cloudflare response headers. This file is a TEMPLATE: `npm run build`
# (scripts/postbuild.mjs) fills in the {{...}} hashes from the built
# index.html and writes the result to dist/_headers.
#
# Security headers apply to every response. The Content-Security-Policy
# allows only this site's own files, plus the two small inline blocks in
# index.html (allowed by their SHA-256 hash — no 'unsafe-inline'), plus one
# explicit exception: frame-src google.com, for the embedded Google Maps
# location on the homepage (components/common iframe in pages/Home) — the
# only third-party content this site loads. WhatsApp and phone links are
# navigations, which CSP does not restrict.
#
# Strict-Transport-Security (HSTS) is deliberately NOT set here yet: it must
# only be sent once the final HTTPS domain is confirmed, because browsers
# remember it (see docs/deployment.md).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' {{SCRIPT_HASHES}}; style-src 'self' {{STYLE_HASHES}}; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

# Caching. HTML is left at Cloudflare's default (always revalidate) so a new
# release shows up immediately.
#
# /assets/* — every file name contains a hash of its content, so a changed file
# gets a new name: safe to cache for a year and never revalidate.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Photos keep the same file name when replaced, so they get a shorter lifetime:
# a week for destination photos, a day for brand files (logo, favicon, share image).
/images/destinations/*
  Cache-Control: public, max-age=604800

/images/brand/*
  Cache-Control: public, max-age=86400

/videos/*
  Cache-Control: public, max-age=604800

# robots.txt and sitemap.xml are plain-text/XML files with no scripts or
# subresources of their own, so the page Content-Security-Policy above does
# not apply to them and is explicitly removed (Cloudflare's "! Header-Name"
# syntax). Left in place, that CSP blocks the browser's own internal
# script+stylesheet that renders sitemap.xml as a collapsible, syntax-
# highlighted XML tree — without it, the browser falls back to dumping
# every text node inline with no line breaks, which is indistinguishable
# from a corrupt file even though the XML itself is perfectly valid.
/robots.txt
  ! Content-Security-Policy
  Cache-Control: public, max-age=3600

/sitemap.xml
  ! Content-Security-Policy
  Cache-Control: public, max-age=3600
